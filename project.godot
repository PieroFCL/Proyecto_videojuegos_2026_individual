; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="La Ultima Fosa"
run/main_scene="res://playground.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CameraManager="*uid://whfoj3ndug50"
LevelManager="*uid://ccon4jablt4vf"
InventoryManager="*uid://b1y70h1yr2xs5"
Events="*uid://b74tunoi5fcs1"
PlayerStats="*uid://dw0nvdm0n5ymg"
EquipmentManager="*uid://brdjg5kj4fbr3"
CombatManager="*uid://bfxx1x36pec14"

[display]

window/size/viewport_width=360
window/size/viewport_height=240
window/size/window_width_override=920
window/size/window_height_override=613
window/stretch/mode="canvas_items"

[filesystem]

import/blender/enabled=false

